auto>1</m_topic_auto><output_html>1</output_html><sitemap_fields><priority>50</priority><changefreq><![CDATA[daily]]></changefreq><lastmod>0</lastmod></sitemap_fields><output_chm>1</output_chm><output_rtf>1</output_rtf><output_pdf>1</output_pdf><output_epub>1</output_epub><page_state_flags><page_state_readonly>0</page_state_readonly><page_state_comment><![CDATA[]]></page_state_comment><page_state_status><![CDATA[Not Started]]></page_state_status></page_state_flags><node_created>1</node_created><has_auto_number>0</has_auto_number><m_show_header_and_footer>0</m_show_header_and_footer><m_has_page_number>1</m_has_page_number><m_title><![CDATA[2.11. Pulling data from Temco hardware]]></m_title><m_description><![CDATA[&Bpara_group&C&Bp&C&G&Bpara_align&C3&B/para_align&C&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&B/font&C&B/field&C&Bitem type = &Epara_start&E/&C&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&B/font&C&B/field&C&Bitem type=&Etitle_region&E&C&Bmain_tag&C&B![CDATA[page_title]]&C&B/main_tag&C&F&G&Bpara_group&C&Bp&C&G&Bpara_align&C3&B/para_align&C&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E13&E w=&E0&E chs=&E1&E d=&Ehaaaaa&E fc=&EArial&E cl=&E11558199&E si=&E1&E sm=&E4506&E ss=&Eh1&E&C&B/font&C&B/field&C&Bitem type = &Epara_start&E/&C&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E13&E w=&E0&E chs=&E1&E d=&Ehaaaaa&E fc=&EArial&E cl=&E11558199&E si=&E1&E sm=&E4506&E ss=&Eh1&E&C&Bitem type = &Enormal&E&C&B![CDATA[2.11. Pulling data from Temco hardware]]&C&B/item&C&B/font&C&B/field&C&B/p&C&G&B/para_group&C&B/item&C&B/p&C&G&Bp&C&G&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&B/font&C&B/field&C&Bitem type = &Epara_start&E/&C&B/p&C&G&Bp&C&G&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&B/font&C&B/field&C&Bitem type = &Epara_start&E/&C&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&Bitem type = &Enormal&E&C&B![CDATA[After setting nodes we can pull data from temco hardware such as T3000. Follow following steps to pull the data:]]&C&B/item&C&B/font&C&B/field&C&B/p&C&G&Bp&C&G&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&B/font&C&B/field&C&Bitem type = &Epara_start&E/&C&B/p&C&G&Bp&C&G&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&B/font&C&B/field&C&Bitem type = &Epara_start&E/&C&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&Bitem type = &Enormal&E&C&B![CDATA[1. Turn on T3000]]&C&B/item&C&B/font&C&B/field&C&B/p&C&G&Bp&C&G&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&B/font&C&B/field&C&Bitem type = &Epara_start&E/&C&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&Bitem type = &Enormal&E&C&B![CDATA[2. insert some nodes.]]&C&B/item&C&B/font&C&B/field&C&B/p&C&G&Bp&C&G&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&B/font&C&B/field&C&Bitem type = &Epara_start&E/&C&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&Bitem type = &Enormal&E&C&B![CDATA[3. Go to edit node]]&C&B/item&C&B/font&C&B/field&C&B/p&C&G&Bp&C&G&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&B/font&C&B/field&C&Bitem type = &Epara_start&E/&C&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&Bitem type = &Enormal&E&C&B![CDATA[4. Click on dropdown menu of source (either temperature or pressure which ever you want to pull the data)]]&C&B/item&C&B/font&C&B/field&C&B/p&C&G&Bp&C&G&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&B/font&C&B/field&C&Bitem type = &Epara_start&E/&C&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&Bitem type = &Enormal&E&C&B![CDATA[5. Click on device]]&C&B/item&C&B/font&C&B/field&C&B/p&C&G&Bp&C&G&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&B/font&C&B/field&C&Bitem type = &Epara_start&E/&C&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&Bitem type = &Enormal&E&C&B![CDATA[6. Input hardware detail. ]]&C&B/item&C&B/font&C&B/field&C&B/p&C&G&Bp&C&G&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&B/font&C&B/field&C&Bitem type = &Epara_start&E/&C&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&Bitem type = &Enormal&E&C&B![CDATA[7. Click ok]]&C&B/item&C&B/font&C&B/field&C&B/p&C&G&Bp&C&G&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&B/font&C&B/field&C&Bitem type = &Epara_start&E/&C&B/p&C&G&Bp&C&G&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&B/font&C&B/field&C&Bitem type = &Epara_start&E/&C&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&Bitem type = &Enormal&E&C&B![CDATA[Hardware detail : ]]&C&B/item&C&B/font&C&B/field&C&B/p&C&G&Bp&C&G&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&B/font&C&B/field&C&Bitem type = &Epara_start&E/&C&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&Bitem type = &Enormal&E&C&B![CDATA[If you want to pull the data from controller 1 and from input section which have index 2 in T3000 then type:]]&C&B/item&C&B/font&C&B/field&C&B/p&C&G&Bp&C&G&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&B/font&C&B/field&C&Bitem type = &Epara_start&E/&C&B/p&C&G&Bp&C&G&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&B/font&C&B/field&C&Bitem type = &Epara_start&E/&C&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs=&E1&E d=&Eeaaaaa&E fc=&EArial&E cl=&E0&E si=&E0&E sm=&E4490&E ss=&Enormal&E&C&Bitem type = &Enormal&E&C&B![CDATA[1-IN2]]&C&B/item&C&B/font&C&B/field&C&B/p&C&G&Bp&C&G&Bfield id = &E0&E data = &ENO_DATA&E&C&Bfont v=&E2&E h=&E11&E w=&E0&E chs